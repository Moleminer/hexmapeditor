@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Web
@using Microsoft.AspNetCore.Html
@{
    HtmlString modelJson = Model.TileMapString;
    HtmlString modelAssets = Model.AssetList;
    ViewData["Title"] = "World Map";
}



<div class="text-center">
    <h1 class="display-4">World Map</h1>
    <div class="main-container"> 
    @await Component.InvokeAsync("RenderMap",
                 new { 
                     tileMapString =  Model.TileMapString,
                     assetList = Model.AssetList
                     }
                 )
    </div> 

    <p id = "debug"></p>
    
</div>

<div id="overlay" onclick="closeNote()"></div>
<div id="overlay-window"">
    <div><label for="noteinput"><h1>Showing Cell Notes:</h1></label></div>
    <div><textarea id="noteinput" name="noteinput" rows="10" cols="66">
        Default value, something went wrong loading this cell. 
    </textarea></div>
    <div><button id = "noteinput-button">Save</button></div>
  </div>

@section Scripts {
    <script src="\js\hexagon.js"></script>
    <script src="\js\clickinteraction.js"></script>
    <script>
// These are defined in the viewcomponent
@* const EMPTY_HEX_GRID_HEIGHT = 32;
const EMPTY_HEX_GRID_WIDTH = 23;
const HEX_RADIUS = 15; *@

//TODO: Seperate functionality between index and editmap, or make a shared fragment
function setBrush(brushType) {
    sessionStorage.setItem("brush", brushType);
    const brushLabel = document.getElementById("brushLabel");
    brushLabel.textContent = brushType.charAt(0).toUpperCase() +
            brushType.substr(1).toLowerCase();;
}

function save()
{
    var hexmap = JSON.parse(sessionStorage.getItem("assets"));
	const form = document.createElement('form');
    form.id = "transferForm";
    const input = document.createElement('input');
    form.method = "POST";
    form.action  = "/profile/editmap/mole";
    input.value = hexmap;
    input.type = "hidden";
    input.name = "transferForm";
    form.append(input);
    document.body.append(form);
    form.submit();
}

// Main:   
document.addEventListener("DOMContentLoaded", function () {
    // Set click action to open note
    sessionStorage.setItem("clickAction", "note");

    const debug = document.getElementById("debug");
    if ((EMPTY_HEX_GRID_HEIGHT > 0) && (EMPTY_HEX_GRID_WIDTH > 0)) {
        // TODO: The first 2 20s are just floating at start of this file
        var hex_list = JSON.parse(sessionStorage.getItem("hexlist"));

    }

    glazeWithInteract(hex_list);

    sessionStorage.setItem("brush", "grass");
    });



</script>
}