@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Web
@using Microsoft.AspNetCore.Html
@{
    HtmlString modelJson = Model.TileMapString;
    HtmlString modelAssets = Model.AssetList;
    ViewData["Title"] = "World Map";
}



<div class="text-center">
    <h1 class="display-4">World Map</h1>
    <div class="main-container"> 
    @await Component.InvokeAsync("RenderMap",
                new { 
                    tileMapString =  Model.TileMapString,
                    assetList = Model.AssetList
                    }
                )
    </div> 
    

    <p id = "debug"></p>
    
    
</div>

<div id="overlay" onclick="closeNote()"></div>
<div id="overlay-window">
    <div><label for="note-input"><h1>Showing Cell Notes:</h1></label></div>
    <div><textarea id="note-input" name="note-input" rows="5" cols="33">
        Default value, something went wrong loading this cell. 
    </textarea></div>
    <div><button id = "note-input-button">Save</button></div>
  </div>

@section Scripts {
    <script src="\js\hexagon.js"></script>
    <script src="\js\clickinteraction.js"></script>
    <script>
        function setBrush(brushType) {
            sessionStorage.setItem("brush", brushType);
            const brushLabel = document.getElementById("brushLabel");
            brushLabel.textContent = brushType.charAt(0).toUpperCase() +
                    brushType.substr(1).toLowerCase();;
        }

        function save()
        {
            var hexmap = sessionStorage.getItem("hexmap");
            const form = document.createElement('form');
            form.id = "transferForm";
            const input = document.createElement('input');
            form.method = "POST";
            form.action  = "/profile/editmap/mole";
            input.value = hexmap;
            input.type = "hidden";
            input.name = "transferForm";
            form.append(input);
            document.body.append(form);
            form.submit();
        }

        // Main:   
        True = true;
        False = false;


        document.addEventListener("DOMContentLoaded", function () {
            // Set click action to paint
            // TODO: Swap to an enum for less human error
            sessionStorage.setItem("clickAction", "paint");
            var hex_list = JSON.parse(sessionStorage.getItem("hexlist"));

            glazeWithInteract(hex_list);
            
            sessionStorage.setItem("brush", "grass");
        })
    </script>
    <script id="add-legend-palette">
        function addLegendPalette() {
            
            const assets = JSON.parse(sessionStorage.getItem("assets"));
            const legend = document.getElementById("legend");
            var firstElement = true;
            assets.forEach((element, index) => {
                if (element["Filename"].includes("_admin")) {
                    return;
                }

                const legendElementDiv = document.getElementById(`legend-${element["Name"]}`);

                if (firstElement == true) {
                    const saveButton = document.getElementById('legendSaveButton')
                    saveButton.addEventListener("click", () => { save() });
                    saveButton.hidden = false;
                    saveButton.textContent = "Save"

                    const brushLabel = document.createElement("label");
                    brushLabel.innerHTML = "Brush: <a id=\"brushLabel\">Grass</a><br/>"
                    legend.insertBefore(brushLabel, legendElementDiv)

                    const emptybtn = document.createElement('input');
                    emptybtn.type = "radio";
                    emptybtn.id = "brushButton0";
                    emptybtn.name = "brushButtons";
                    emptybtn.addEventListener("click", () => {
                        setBrush("erase")
                    });
                    legend.insertBefore(emptybtn, legendElementDiv)

                    firstElement = false;
                }
                
                const radiobtn = document.createElement('input');
                radiobtn.type = "radio";
                if (index == 0) {
                    radiobtn.checked = true;
                }
                radiobtn.id = `brushButton${index+1}`;
                radiobtn.name = "brushButtons";
                radiobtn.addEventListener("click", () => {
                    setBrush(element["Filename"])
                });

                legendElementDiv.appendChild(radiobtn)
                });
        }
        document.addEventListener("DOMContentLoaded", function () {
            addLegendPalette()
        })
    </script>
}