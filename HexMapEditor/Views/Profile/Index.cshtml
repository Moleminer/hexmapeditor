@* TODO: A page to show character sheet and XP will go here *@
@using Microsoft.AspNetCore.Html
@using HexMapEditor.Data
@{
	string name = User.Identity.Name;
}
@{
    ViewData["Title"] = $"{name}'s Profile";
}



<div class="text-center">
    <h1 class="display-4">Welcome, @name</h1>
    <div class="main-container"> 
        <div>Character sheet goes here</div>
		<button>Go to Character Sheet (Unimplemented)</button>
		@{
			if (Model.IsAdmin == true) {
				<button class="nav-link text-dark" asp-area="" asp-controller="Profile" asp-action="EditMap">Edit Map</button>
			}
		}
    </div> 
    
</div>